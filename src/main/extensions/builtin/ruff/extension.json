{
  "schemaVersion": 1,
  "id": "ruff",
  "name": "Ruff",
  "version": "1.0.0",
  "publisher": "krt",
  "description": "Python lint diagnostics for managed worktrees.",
  "kind": ["language", "linter"],
  "activation": {
    "globs": ["**/*.py", "**/pyproject.toml"],
    "languages": ["python"]
  },
  "contributes": {
    "lsp": {
      "command": {
        "program": "ruff",
        "args": ["server"]
      },
      "transport": "stdio",
      "languages": ["python"],
      "features": ["diagnostics"]
    }
  }
}
