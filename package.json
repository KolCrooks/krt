{
  "name": "krt2",
  "productName": "KRT",
  "version": "0.1.0",
  "description": "KRT desktop app",
  "author": "Kol Crooks",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main/index.js",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@octokit/graphql": "^9.0.1",
    "@octokit/rest": "^22.0.0",
    "@pierre/diffs": "1.2.2",
    "@pierre/trees": "1.0.0-beta.4",
    "@tanstack/react-query": "^5.90.12",
    "@vscode/ripgrep": "^1.18.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.566.0",
    "marked": "^18.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/asar": "4.2.0",
    "@electron/get": "5.0.0"
  }
}
